# templates with fake values and are committed.
avicontroller-credentials.json
cloudflare.ini
tests/integration/integration-credentials.json
*credentials*.json
!tests/integration/integration-credentials.json.example
# Let's Encrypt account keys and other private keys.
*.key
*.pem

